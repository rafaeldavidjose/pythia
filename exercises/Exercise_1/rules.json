{
  "title": "Gestão de notas",
  "load_inputs": ["fim"],
  "ai_trap": ["nota_secreta"],
  "criteria": [
    {
      "criterion": "media",
      "points": 4,
      "description": "Devolve a média das notas, ou 0 se a lista é vazia.",
      "tests": [
        {"name": "returns",
         "params": {"function": "media", "args": [[10, 12, 14]]}},
        {"name": "returns",
         "params": {"function": "media", "args": [[15]], "expected": 15}},
        {"name": "returns",
         "params": {"function": "media", "args": [[]]},
         "hint": "Uma lista vazia tem média 0."}
      ]
    },
    {
      "criterion": "classificar",
      "points": 4,
      "description": "Aprovado, Reprovado ou Inválida.",
      "tests": [
        {"name": "returns",
         "params": {"function": "classificar", "args": [15]}},
        {"name": "returns",
         "params": {"function": "classificar", "args": [10]},
         "hint": "10 já é aprovado (>= 10)."},
        {"name": "returns",
         "params": {"function": "classificar", "args": [9.5]}},
        {"name": "returns",
         "params": {"function": "classificar", "args": [-1]},
         "hint": "Fora de [0, 20] é inválida."},
        {"name": "returns",
         "params": {"function": "classificar", "args": [21]},
         "hint": "Fora de [0, 20] é inválida."}
      ]
    },
    {
      "criterion": "contar_aprovados",
      "points": 3,
      "description": "Conta as notas >= 10.",
      "tests": [
        {"name": "defines", "weight": 0.5,
         "params": {"function": "contar_aprovados"}},
        {"name": "returns",
         "params": {"function": "contar_aprovados",
                    "args": [[8, 10, 12, 19]]}},
        {"name": "returns",
         "params": {"function": "contar_aprovados", "args": [[]]}},
        {"name": "returns",
         "params": {"function": "contar_aprovados", "args": [[9.9, 3]]}}
      ]
    },
    {
      "criterion": "subir_notas",
      "points": 3,
      "description": "Soma o bónus a cada nota, com máximo de 20.",
      "tests": [
        {"name": "mutates",
         "params": {"function": "subir_notas", "args": [[10, 12], 2]},
         "hint": "A função altera a lista recebida, não cria outra."},
        {"name": "mutates",
         "params": {"function": "subir_notas", "args": [[18, 20], 5],
                    "expected": [20, 20]},
         "hint": "Nenhuma nota passa de 20."}
      ]
    },
    {
      "criterion": "mostrar_resultado",
      "points": 2,
      "description": "Imprime o nome, a nota e a classificação.",
      "tests": [
        {"name": "prints",
         "params": {"function": "mostrar_resultado", "args": ["Ana", 15]}},
        {"name": "prints",
         "params": {"function": "mostrar_resultado", "args": ["Rui", 8],
                    "expected": "Rui: 8 (Reprovado)"}}
      ]
    },
    {
      "criterion": "Programa",
      "points": 4,
      "description": "Lê notas até 'fim' e mostra a média e os aprovados.",
      "tests": [
        {"name": "program",
         "params": {"inputs": ["12", "8", "fim"],
                    "contains": ["Média: 10.0", "Aprovados: 1"]},
         "label": "programa: notas 12 e 8"},
        {"name": "program",
         "params": {"inputs": ["fim"],
                    "contains": ["Média: 0.0", "Aprovados: 0"]},
         "label": "programa: sem notas"}
      ]
    }
  ]
}
